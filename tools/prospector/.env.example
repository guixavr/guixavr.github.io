# Copie para .env e preencha. O .env nunca vai para o GitHub.

# Google Places API (busca de negócios). Crie em https://console.cloud.google.com/
# Ative "Places API (New)" e restrinja a chave a essa API.
GOOGLE_PLACES_API_KEY=

# Claude (textos da prévia e mensagens). Crie em https://platform.claude.com/
# Sem chave, o sistema usa textos-modelo.
ANTHROPIC_API_KEY=
