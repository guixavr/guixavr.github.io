---
import type { Lang } from '../data/site';
import { profile, whatsappLink } from '../data/site';
import { t } from '../i18n/ui';
import Icon from './Icon.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const d = t(lang).contact;
---

<section id="contato" class="px-5 pb-24 sm:px-8 sm:pb-32">
  <div
    class="reveal relative mx-auto max-w-6xl overflow-hidden rounded-3xl border border-line bg-surface px-6 py-16 text-center sm:px-12 sm:py-24"
  >
    <div class="bg-grid pointer-events-none absolute inset-0"></div>
    <div
      class="pointer-events-none absolute bottom-[-10rem] left-1/2 h-80 w-[40rem] -translate-x-1/2 rounded-full bg-accent-strong/25 blur-[110px]"
    >
    </div>

    <div class="relative">
      <p class="font-mono text-xs tracking-[0.2em] text-accent uppercase">{d.eyebrow}</p>
      <h2 class="mx-auto mt-4 max-w-2xl text-3xl font-semibold tracking-tight text-balance sm:text-5xl">{d.title}</h2>
      <p class="mx-auto mt-5 max-w-xl text-lg text-muted">{d.subtitle}</p>

      <div class="mt-10 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <a
          href={whatsappLink(lang)}
          target="_blank"
          rel="noopener"
          class="inline-flex w-full items-center justify-center gap-2 rounded-full bg-fg px-6 py-3.5 font-medium text-bg transition hover:bg-white sm:w-auto"
        >
          <Icon name="whatsapp" class="size-5" />
          {d.whatsapp}
        </a>
        <a
          href={`mailto:${profile.email}`}
          class="inline-flex w-full items-center justify-center gap-2 rounded-full border border-line bg-bg/50 px-6 py-3.5 font-medium transition hover:border-subtle sm:w-auto"
        >
          <Icon name="mail" class="size-5" />
          {d.email}
        </a>
      </div>

      <button
        type="button"
        id="copy-email"
        data-email={profile.email}
        data-copied={d.copied}
        class="mt-6 inline-flex items-center gap-2 font-mono text-sm text-muted transition-colors hover:text-fg"
        aria-label={d.copy}
        title={d.copy}
      >
        <span>{profile.email}</span>
        <Icon name="copy" class="size-4" />
      </button>
    </div>
  </div>
</section>

<script>
  const btn = document.getElementById('copy-email') as HTMLButtonElement | null;
  btn?.addEventListener('click', async () => {
    const label = btn.querySelector('span')!;
    const email = btn.dataset.email!;
    try {
      await navigator.clipboard.writeText(email);
      label.textContent = btn.dataset.copied!;
      setTimeout(() => (label.textContent = email), 1800);
    } catch {
      window.location.href = `mailto:${email}`;
    }
  });
</script>
