---
import type { Lang } from '../data/site';
import { profile, whatsappLink } from '../data/site';
import { t, homePath } from '../i18n/ui';
import Icon from './Icon.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const d = t(lang).nav;
const other: Lang = lang === 'pt' ? 'en' : 'pt';

const links = [
  { href: '#servicos', label: d.services },
  { href: '#projetos', label: d.work },
  { href: '#sobre', label: d.about },
  { href: '#processo', label: d.process },
  { href: '#contato', label: d.contact },
];
---

<header
  id="site-header"
  class="fixed inset-x-0 top-0 z-50 border-b border-transparent transition-colors duration-300 data-[scrolled]:border-line data-[scrolled]:bg-bg/75 data-[scrolled]:backdrop-blur-xl"
>
  <nav class="mx-auto flex h-16 max-w-6xl items-center justify-between px-5 sm:px-8" aria-label="Principal">
    <a href={homePath(lang)} class="font-mono text-sm font-semibold tracking-tight">
      <span class="text-accent">&gt;_</span> {profile.shortName}
    </a>

    <ul class="hidden items-center gap-8 text-sm text-muted md:flex">
      {links.map((l) => (
        <li>
          <a href={l.href} class="transition-colors hover:text-fg">{l.label}</a>
        </li>
      ))}
    </ul>

    <div class="flex items-center gap-2">
      <a
        href={homePath(other)}
        hreflang={other === 'pt' ? 'pt-BR' : 'en'}
        class="inline-flex items-center gap-1.5 rounded-full px-3 py-2 font-mono text-xs text-muted uppercase transition-colors hover:text-fg"
        aria-label={d.switchLang}
        title={d.switchLang}
      >
        <Icon name="globe" class="size-4" />
        {other}
      </a>
      <a
        href={whatsappLink(lang)}
        target="_blank"
        rel="noopener"
        class="hidden rounded-full bg-fg px-4 py-2 text-sm font-medium text-bg transition hover:bg-white sm:inline-flex"
      >
        {d.cta}
      </a>
      <button
        id="menu-toggle"
        type="button"
        class="inline-flex size-10 items-center justify-center rounded-full text-muted hover:text-fg md:hidden"
        aria-controls="mobile-menu"
        aria-expanded="false"
        aria-label={d.menu}
      >
        <Icon name="menu" class="size-5 [[aria-expanded=true]>&]:hidden" />
        <Icon name="close" class="hidden size-5 [[aria-expanded=true]>&]:block" />
      </button>
    </div>
  </nav>

  <div id="mobile-menu" class="hidden border-t border-line bg-bg/95 backdrop-blur-xl md:hidden">
    <ul class="mx-auto flex max-w-6xl flex-col px-5 py-4">
      {links.map((l) => (
        <li>
          <a href={l.href} class="block py-3 text-lg text-muted hover:text-fg">{l.label}</a>
        </li>
      ))}
      <li class="pt-3">
        <a
          href={whatsappLink(lang)}
          target="_blank"
          rel="noopener"
          class="flex justify-center rounded-full bg-fg px-4 py-3 font-medium text-bg"
        >
          {d.cta}
        </a>
      </li>
    </ul>
  </div>
</header>

<script>
  const header = document.getElementById('site-header')!;
  const toggle = document.getElementById('menu-toggle')!;
  const menu = document.getElementById('mobile-menu')!;

  const onScroll = () => header.toggleAttribute('data-scrolled', window.scrollY > 24 || !menu.classList.contains('hidden'));
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  const setOpen = (open: boolean) => {
    menu.classList.toggle('hidden', !open);
    toggle.setAttribute('aria-expanded', String(open));
    onScroll();
  };
  toggle.addEventListener('click', () => setOpen(menu.classList.contains('hidden')));
  menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
</script>
