---
import type { Lang } from '../data/site';
import { t } from '../i18n/ui';
import SectionHeading from './SectionHeading.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const d = t(lang).process;
---

<section id="processo" class="border-t border-line py-24 sm:py-32">
  <div class="mx-auto max-w-6xl px-5 sm:px-8">
    <SectionHeading eyebrow={d.eyebrow} title={d.title} />
    <ol class="mt-14 grid gap-px overflow-hidden rounded-2xl border border-line bg-line sm:grid-cols-2 lg:grid-cols-4">
      {d.steps.map((s, i) => (
        <li class="reveal bg-bg p-8">
          <span class="font-mono text-sm text-accent">{String(i + 1).padStart(2, '0')}</span>
          <h3 class="mt-4 text-lg font-semibold tracking-tight">{s.title}</h3>
          <p class="mt-2 text-muted">{s.text}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
