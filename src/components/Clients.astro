---
import type { Lang } from '../data/site';
import { clients } from '../data/site';
import { t } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const d = t(lang).clients;
// Lista duplicada para o loop contínuo
const loop = [...clients, ...clients, ...clients, ...clients];
---

<section class="border-y border-line py-12" aria-labelledby="clients-title">
  <p id="clients-title" class="text-center font-mono text-xs tracking-[0.2em] text-subtle uppercase">{d.title}</p>
  <div
    class="marquee relative mt-8 overflow-hidden [mask-image:linear-gradient(to_right,transparent,#000_12%,#000_88%,transparent)]"
  >
    <ul class="marquee-track flex w-max items-center gap-16 pr-16">
      {loop.map((c, i) => (
        <li aria-hidden={i >= clients.length ? 'true' : undefined} class="shrink-0">
          {c.logo ? (
            <img src={c.logo} alt={c.name} class="h-8 w-auto opacity-60 grayscale transition hover:opacity-100 hover:grayscale-0" />
          ) : (
            <span class="text-xl font-semibold tracking-tight whitespace-nowrap text-subtle transition-colors hover:text-fg sm:text-2xl">
              {c.name}
            </span>
          )}
        </li>
      ))}
    </ul>
  </div>
</section>
