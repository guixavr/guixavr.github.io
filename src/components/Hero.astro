---
import type { Lang } from '../data/site';
import { whatsappLink } from '../data/site';
import { t } from '../i18n/ui';
import Icon from './Icon.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const d = t(lang);
---

<section class="relative overflow-hidden pt-36 pb-20 sm:pt-44 sm:pb-28">
  <div class="bg-grid pointer-events-none absolute inset-0 -z-10"></div>
  <div
    class="pointer-events-none absolute top-[-12rem] left-1/2 -z-10 h-[32rem] w-[52rem] -translate-x-1/2 rounded-full bg-accent-strong/20 blur-[120px]"
  >
  </div>

  <div class="mx-auto max-w-6xl px-5 sm:px-8">
    <div class="max-w-3xl">
      <p
        class="reveal inline-flex items-center gap-2 rounded-full border border-line bg-surface/70 px-3 py-1.5 text-xs text-muted"
      >
        <span class="relative flex size-2">
          <span class="absolute inline-flex size-full animate-ping rounded-full bg-emerald-400 opacity-60 motion-reduce:hidden"></span>
          <span class="relative inline-flex size-2 rounded-full bg-emerald-400"></span>
        </span>
        {d.hero.badge}
      </p>

      <h1
        class="reveal mt-6 text-4xl leading-[1.05] font-semibold tracking-tight text-balance sm:text-6xl lg:text-7xl"
      >
        {d.hero.titleA}
        <span class="bg-gradient-to-r from-accent via-fuchsia-300 to-sky-300 bg-clip-text text-transparent">
          {d.hero.titleB}
        </span>
      </h1>

      <p class="reveal mt-6 max-w-2xl text-lg text-pretty text-muted sm:text-xl">{d.hero.subtitle}</p>

      <div class="reveal mt-10 flex flex-col gap-3 sm:flex-row">
        <a
          href={whatsappLink(lang)}
          target="_blank"
          rel="noopener"
          class="group inline-flex items-center justify-center gap-2 rounded-full bg-fg px-6 py-3.5 font-medium text-bg transition hover:bg-white"
        >
          <Icon name="whatsapp" class="size-5" />
          {d.hero.primary}
          <Icon name="arrow" class="size-4 transition-transform group-hover:translate-x-0.5" />
        </a>
        <a
          href="#projetos"
          class="inline-flex items-center justify-center gap-2 rounded-full border border-line px-6 py-3.5 font-medium text-fg transition hover:border-subtle hover:bg-surface"
        >
          {d.hero.secondary}
        </a>
      </div>
    </div>

    <dl class="reveal mt-20 grid gap-px overflow-hidden rounded-2xl border border-line bg-line sm:grid-cols-3">
      {d.stats.map((s) => (
        <div class="bg-bg p-6 sm:p-8">
          <dt class="text-sm text-muted">{s.label}</dt>
          <dd class="order-first text-2xl font-semibold tracking-tight sm:text-3xl">{s.value}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>
