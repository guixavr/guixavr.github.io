---
import type { Lang } from '../data/site';
import { profile, stack } from '../data/site';
import { t } from '../i18n/ui';
import Icon from './Icon.astro';
import SectionHeading from './SectionHeading.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const d = t(lang).about;
---

<section id="sobre" class="border-t border-line py-24 sm:py-32">
  <div class="mx-auto grid max-w-6xl gap-14 px-5 sm:px-8 lg:grid-cols-[1fr_1.1fr] lg:gap-20">
    <div>
      <SectionHeading eyebrow={d.eyebrow} title={d.title} />
      <div class="reveal mt-6 space-y-4 text-lg text-pretty text-muted">
        {d.paragraphs.map((p) => <p>{p}</p>)}
      </div>
      <div class="reveal mt-8 flex flex-wrap gap-3">
        <a
          href={profile.resume}
          target="_blank"
          rel="noopener"
          class="inline-flex items-center gap-2 rounded-full border border-line px-4 py-2.5 text-sm transition hover:border-subtle hover:bg-surface"
        >
          <Icon name="file" class="size-4" />
          {d.resume}
        </a>
        <a
          href={profile.linkedin}
          target="_blank"
          rel="noopener"
          class="inline-flex items-center gap-2 rounded-full border border-line px-4 py-2.5 text-sm transition hover:border-subtle hover:bg-surface"
        >
          <Icon name="linkedin" class="size-4" />
          LinkedIn
        </a>
        <a
          href={profile.github}
          target="_blank"
          rel="noopener"
          class="inline-flex items-center gap-2 rounded-full border border-line px-4 py-2.5 text-sm transition hover:border-subtle hover:bg-surface"
        >
          <Icon name="github" class="size-4" />
          GitHub
        </a>
      </div>
    </div>

    <div class="reveal rounded-2xl border border-line bg-surface p-6 sm:p-8">
      <h3 class="font-mono text-xs tracking-[0.2em] text-subtle uppercase">{d.stackTitle}</h3>
      <dl class="mt-6 space-y-6">
        {stack.map((g) => (
          <div>
            <dt class="text-sm font-medium">{g.area[lang]}</dt>
            <dd class="mt-3 flex flex-wrap gap-2">
              {g.items.map((i) => (
                <span class="rounded-lg border border-line bg-surface-2 px-3 py-1.5 text-sm text-muted">{i}</span>
              ))}
            </dd>
          </div>
        ))}
      </dl>
    </div>
  </div>
</section>
