---
interface Props {
  eyebrow: string;
  title: string;
  subtitle?: string;
  center?: boolean;
}
const { eyebrow, title, subtitle, center = false } = Astro.props;
---

<div class:list={['reveal max-w-2xl', center && 'mx-auto text-center']}>
  <p class="font-mono text-xs tracking-[0.2em] text-accent uppercase">{eyebrow}</p>
  <h2 class="mt-3 text-3xl font-semibold tracking-tight text-balance sm:text-4xl">{title}</h2>
  {subtitle && <p class="mt-4 text-lg text-pretty text-muted">{subtitle}</p>}
</div>
