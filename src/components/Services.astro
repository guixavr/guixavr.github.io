---
import type { Lang } from '../data/site';
import { t } from '../i18n/ui';
import Icon from './Icon.astro';
import SectionHeading from './SectionHeading.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const d = t(lang).services;
---

<section id="servicos" class="py-24 sm:py-32">
  <div class="mx-auto max-w-6xl px-5 sm:px-8">
    <SectionHeading eyebrow={d.eyebrow} title={d.title} subtitle={d.subtitle} />
    <ul class="mt-14 grid gap-4 sm:grid-cols-2">
      {d.items.map((s) => (
        <li class="reveal group relative overflow-hidden rounded-2xl border border-line bg-surface p-8 transition-colors hover:border-subtle">
          <div class="pointer-events-none absolute -top-24 -right-24 size-48 rounded-full bg-accent/10 opacity-0 blur-3xl transition-opacity duration-500 group-hover:opacity-100" />
          <span class="inline-flex size-11 items-center justify-center rounded-xl border border-line bg-surface-2 text-accent">
            <Icon name={s.icon} class="size-5" />
          </span>
          <h3 class="mt-6 text-xl font-semibold tracking-tight">{s.title}</h3>
          <p class="mt-2 text-muted">{s.text}</p>
        </li>
      ))}
    </ul>
  </div>
</section>
