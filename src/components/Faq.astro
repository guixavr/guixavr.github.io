---
import type { Lang } from '../data/site';
import { t } from '../i18n/ui';
import Icon from './Icon.astro';
import SectionHeading from './SectionHeading.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const d = t(lang).faq;
---

<section class="py-24 sm:py-32">
  <div class="mx-auto grid max-w-6xl gap-12 px-5 sm:px-8 lg:grid-cols-[1fr_2fr]">
    <SectionHeading eyebrow={d.eyebrow} title={d.title} />
    <div class="reveal divide-y divide-line border-y border-line">
      {d.items.map((item) => (
        <details class="group py-2" name="faq">
          <summary class="flex cursor-pointer items-center justify-between gap-6 py-4 text-lg font-medium">
            {item.q}
            <Icon name="plus" class="size-5 shrink-0 text-muted transition-transform duration-300 group-open:rotate-45" />
          </summary>
          <p class="pb-5 text-muted">{item.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>
