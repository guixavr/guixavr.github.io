---
import Base from '../layouts/Base.astro';
import { t } from '../i18n/ui';

const d = t('pt').notFound;
const e = t('en').notFound;
---

<Base lang="pt" title={`404 · ${d.title}`} noindex>
  <main class="relative flex min-h-dvh flex-col items-center justify-center px-5 text-center">
    <div class="bg-grid pointer-events-none absolute inset-0 -z-10"></div>
    <p class="font-mono text-sm text-accent">404</p>
    <h1 class="mt-3 text-4xl font-semibold tracking-tight">{d.title}</h1>
    <p class="mt-3 text-muted">{d.text} <span class="text-subtle">· {e.text}</span></p>
    <div class="mt-8 flex gap-3">
      <a href="/" class="rounded-full bg-fg px-5 py-3 text-sm font-medium text-bg">{d.back}</a>
      <a href="/en/" class="rounded-full border border-line px-5 py-3 text-sm font-medium">{e.back}</a>
    </div>
  </main>
</Base>
